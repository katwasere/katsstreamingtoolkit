<Window x:Class="KatStreamToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KatStreamToolkit.ViewModels"
        xmlns:local="clr-namespace:KatStreamToolkit.Views"
        Title="KAT's Streaming Toolkit" Height="720" Width="1100"
        Background="#FF16181D" Foreground="#FFE6E8EB"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Inverted="True" />
        <local:LightBrushConverter x:Key="LightBrush" />
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FF1B1E24" Padding="12,6">
            <TextBlock Text="{Binding BandwidthSummary, Mode=OneWay}" Foreground="#FF9AA0A8" FontSize="12" />
        </Border>

        <TabControl Margin="8">
            <TabItem Header="Relay &amp; Routing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">

                        <TextBlock Text="Go live" FontSize="18" FontWeight="Bold" Margin="0,4,0,8" />
                        <Border Background="#FF23272E" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Start stream" Command="{Binding GoLiveCommand}" Padding="16,5" FontWeight="SemiBold" />
                                    <Button Content="End stream" Command="{Binding EndStreamCommand}" Margin="8,0,0,0" Padding="16,5" />
                                    <TextBlock Text="{Binding GoLiveStatusText, Mode=OneWay}" Margin="14,0,0,0" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="#FF8FD694" />
                                    <TextBlock Text="{Binding IsRunning, StringFormat=busy: {0}}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="#FF9AA0A8" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox Content="Control OBS (obs-websocket)" IsChecked="{Binding Config.ObsEnabled}" VerticalAlignment="Center" />
                                    <TextBlock Text="  ws url:" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    <TextBox Width="180" Text="{Binding Config.ObsWebSocketUrl}" VerticalAlignment="Center" />
                                    <TextBlock Text="  password:" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <local:SecretBox Width="150" SecretText="{Binding ObsPassword}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ObsConnectionText, Mode=OneWay}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               FontSize="11" Foreground="#FF9AA0A8" />
                                </StackPanel>
                                <TextBlock Text="Start stream: verifies the relay, tells OBS to start (if control is on), then confirms your stream actually arrives. Same PC first: enable the obs-websocket plugin in OBS (Tools -> WebSocket Server Settings), set the same password here."
                                           FontSize="11" Foreground="#FF9AA0A8" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="How your stream travels" FontSize="18" FontWeight="Bold" Margin="0,4,0,8" />
                        <Border Background="#FF23272E" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Border Background="#FF5A2222" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                        Visibility="{Binding HasAlarms, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="WATCHDOG" FontWeight="Bold" FontSize="12" Foreground="#FFFFB4B4" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Alarms}" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,1" LastChildFill="True">
                                                        <Button DockPanel.Dock="Right" Content="restart encoder" Padding="6,1" Margin="10,0,0,0"
                                                                VerticalAlignment="Top"
                                                                Command="{Binding DataContext.RestartEncoderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding CanRestart, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#FFFFE3E3" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Restart relay" Command="{Binding RestartRelayCommand}" Padding="10,3" />
                                            <CheckBox Content="auto-restart frozen encoders" IsChecked="{Binding Config.WatchdogAutoRestart}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                            <CheckBox Content="alarm sound" IsChecked="{Binding Config.AlarmSound}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                <Border Background="#FF2D5B8A" CornerRadius="6" Padding="14,8">
                                    <StackPanel>
                                        <TextBlock Foreground="White" FontWeight="SemiBold"><Run Text="OBS" /><LineBreak /><Run Text="(your PC)" FontSize="10" /></TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding ObsLight, Converter={StaticResource LightBrush}}" />
                                            <TextBlock Text="{Binding ObsLightText, Mode=OneWay}" FontSize="10" Foreground="#FFDDE3EA" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="  ── one stream ──▶  " VerticalAlignment="Center" Foreground="#FF9AA0A8" />
                                <Border Background="#FF6E3A8C" CornerRadius="6" Padding="14,8">
                                    <StackPanel>
                                        <TextBlock Foreground="White" FontWeight="SemiBold"><Run Text="Relay server (VPS)" /><LineBreak /><Run Text="cheap cloud box" FontSize="10" /></TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding RelayLight, Converter={StaticResource LightBrush}}" />
                                            <TextBlock Text="{Binding RelayLightText, Mode=OneWay}" FontSize="10" Foreground="#FFDDE3EA" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="  ──▶  " VerticalAlignment="Center" Foreground="#FF9AA0A8" />
                                <ItemsControl ItemsSource="{Binding Destinations}" Margin="0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,6" CornerRadius="6" Padding="10,6"
                                                    Background="#FF1E4D2E"
                                                    BorderBrush="#FF3C3C3C" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="Opacity" Value="0.35" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Foreground="#FFB9C2CC" FontSize="10">
                                                        <Run Text="{Binding Orientation, Mode=OneWay}" />
                                                        <Run Text=" • " />
                                                        <Run Text="{Binding VideoBitrateKbps, Mode=OneWay}" />
                                                        <Run Text=" kbps" />
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding PushLight, Converter={StaticResource LightBrush}}" />
                                                        <TextBlock Text="{Binding PushLightText, Mode=OneWay}" FontSize="10" Foreground="#FFDDE3EA" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding LiveLight, Converter={StaticResource LightBrush}}" />
                                                        <TextBlock Text="{Binding LiveLightText, Mode=OneWay}" FontSize="10" Foreground="#FFDDE3EA" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Upstream (what OBS sends to your server)" FontSize="15" FontWeight="Bold" Margin="0,8,0,6" />
                        <Border Background="#FF23272E" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Video bitrate (kbps):" Width="180" VerticalAlignment="Center" />
                                    <TextBox Width="90" Text="{Binding Config.Upstream.VideoBitrateKbps}" VerticalAlignment="Center" />
                                    <TextBlock Text="   FPS:" Width="50" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    <TextBox Width="60" Text="{Binding Config.Upstream.Fps}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                    <TextBlock Text="Resolution:" Width="180" VerticalAlignment="Center" />
                                    <TextBox Width="70" Text="{Binding Config.Upstream.Width}" VerticalAlignment="Center" />
                                    <TextBlock Text=" x " Margin="2" VerticalAlignment="Center" />
                                    <TextBox Width="70" Text="{Binding Config.Upstream.Height}" VerticalAlignment="Center" />
                                    <TextBlock Text="(portrait renditions are computed from this)" FontSize="11" Margin="12,0,0,0" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                    <TextBlock Text="Stream name (OBS key):" Width="180" VerticalAlignment="Center" />
                                    <local:SecretBox Width="200" SecretText="{Binding Config.Upstream.StreamName}" VerticalAlignment="Center" />
                                    <TextBlock Text="  your secret - OBS needs this to reach your server" FontSize="11" Margin="8,0,0,0" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                    <TextBlock Text="Server host (IP or domain):" Width="180" VerticalAlignment="Center" />
                                    <local:SecretBox Width="200" SecretText="{Binding Config.ServerHost}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                    <TextBlock Text="Keys file:" Width="180" VerticalAlignment="Center" />
                                    <TextBox Width="340" Text="{Binding KeysFilePathDisplay, Mode=OneWay}" IsReadOnly="True" VerticalAlignment="Center" />
                                    <Button Content="Open..." Command="{Binding OpenKeysFileCommand}" Margin="6,0,0,0" Padding="8,2" VerticalAlignment="Center" />
                                    <Button Content="Move to..." Command="{Binding MoveKeysFileCommand}" Margin="6,0,0,0" Padding="8,2" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Stream keys and the server IP live ONLY in that file - config.json never contains them, so you can share settings without leaking. Point it at a USB stick or sync folder for portability."
                                           FontSize="11" Margin="0,4,0,2" Foreground="#FF9AA0A8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FF5A4A22" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServerConfigOutdatedText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ServerConfigOutdatedText}" TextWrapping="Wrap"
                                       Foreground="#FFFFF0C0" FontWeight="SemiBold" />
                        </Border>

                        <DockPanel Margin="0,8,0,6">
                            <TextBlock Text="Destinations (what the server sends out)" FontSize="15" FontWeight="Bold" />
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Add destination"
                                    Command="{Binding AddDestinationCommand}" Padding="10,3" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Destinations}"
                                  SelectedItem="{Binding SelectedDestination}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" MinHeight="180" Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                                <DataGridComboBoxColumn Header="Platform" SelectedItemBinding="{Binding Platform}" Width="90"
                                                        ItemsSource="{x:Static vm:MainViewModel.AllPlatforms}" />
                                <DataGridComboBoxColumn Header="Orientation" SelectedItemBinding="{Binding Orientation}" Width="100"
                                                        ItemsSource="{x:Static vm:MainViewModel.AllOrientations}" />
                                <DataGridComboBoxColumn Header="Portrait style" SelectedItemBinding="{Binding PortraitStyle}" Width="140"
                                                        ItemsSource="{x:Static vm:MainViewModel.AllPortraitStyles}" />
                                <DataGridTextColumn Header="Ingest URL (from platform dashboard)" Binding="{Binding IngestUrl}" Width="*" />
                                <DataGridTextColumn Header="Handle (live checks)" Binding="{Binding ChannelHandle}" Width="110" />
                                <DataGridTextColumn Header="Live" Binding="{Binding LiveLightText, Mode=OneWay}" Width="110" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Stream key" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <local:SecretBox SecretText="{Binding StreamKey}"
                                                             BorderThickness="0" Background="Transparent"
                                                             VerticalContentAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="kbps" Binding="{Binding VideoBitrateKbps}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="Export server bundle..." Command="{Binding ExportServerCommand}" Padding="12,5" HorizontalAlignment="Left" />
                        <TextBlock Text="Writes a ready-to-deploy folder (Dockerfile + nginx config + step-by-step guide). See the Server tab for a preview."
                                   FontSize="11" Foreground="#FF9AA0A8" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Output Studio">
                <local:OutputStudio />
            </TabItem>

            <TabItem Header="Chat Overlays">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="My channels" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Twitch channel" FontSize="11" Foreground="#FF9AA0A8" />
                        <TextBox Text="{Binding Config.MyChannels.TwitchChannel, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                        <TextBlock Text="Kick channel" FontSize="11" Foreground="#FF9AA0A8" />
                        <TextBox Text="{Binding Config.MyChannels.KickChannel, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                        <TextBlock Text="YouTube (video URL or @handle)" FontSize="11" Foreground="#FF9AA0A8" />
                        <TextBox Text="{Binding Config.MyChannels.YouTubeUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                        <TextBlock Text="TikTok @handle" FontSize="11" Foreground="#FF9AA0A8" />
                        <TextBox Text="{Binding Config.MyChannels.TikTokHandle, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                        <TextBlock Text="TikTok chat API key (Euler Stream)" FontSize="11" Foreground="#FF9AA0A8" />
                        <local:SecretBox SecretText="{Binding EulerApiKey}" Margin="0,2,0,2" />
                        <TextBlock Text="Free key: eulerstream.com - API keys. Only needed for TikTok chat; TikTok video goes through the relay without it." FontSize="10" Foreground="#FF9AA0A8" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="Twitch account (send + mod actions)" FontSize="11" Foreground="#FF9AA0A8" Margin="0,0,0,2" />
                        <TextBlock Text="Twitch app Client ID (dev.twitch.tv console)" FontSize="11" Foreground="#FF9AA0A8" />
                        <TextBox Text="{Binding Config.TwitchClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Log in..." Command="{Binding LoginTwitchCommand}" Padding="10,3" />
                            <Button Content="Log out" Command="{Binding LogoutTwitchCommand}" Margin="6,0,0,0" Padding="10,3" />
                        </StackPanel>
                        <TextBlock Text="{Binding TwitchAccountText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TwitchLoginStatus, Mode=OneWay}" FontSize="10" Foreground="#FF9AA0A8" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="One-time setup: create an app at dev.twitch.tv/console (category Chat Bot), redirect URL http://localhost:8770/ - paste its Client ID above. Login powers !command replies, timeout/ban/delete from the overlay, and slow mode." FontSize="10" Foreground="#FF9AA0A8" TextWrapping="Wrap" Margin="0,2,0,10" />

                        <TextBlock Text="New overlays pre-fill from these." FontSize="10" Foreground="#FF9AA0A8" Margin="0,0,0,6" />
                        <Button Content="Sync overlays from My channels" Command="{Binding SyncOverlaysFromMyChannelsCommand}"
                                Padding="10,3" HorizontalAlignment="Left" />
                        <TextBlock Text="Points every overlay at the channels above (for after rotating channels) and reconnects them." FontSize="10" Foreground="#FF9AA0A8" TextWrapping="Wrap" Margin="0,2,0,10" />

                        <Button Content="Chat diagnostics (raw IRC)..." Command="{Binding CaptureChatDiagnosticsCommand}"
                                Padding="10,3" HorizontalAlignment="Left" />
                        <TextBlock Text="Connects a throwaway reader to your Twitch channel for 15 seconds and shows every raw line. Type in your chat while it runs - if PRIVMSG lines appear here but not in the overlay, the problem is rendering; if not, the problem is delivery." FontSize="10" Foreground="#FF9AA0A8" TextWrapping="Wrap" Margin="0,2,0,10" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add overlay" Command="{Binding AddOverlayCommand}" Padding="10,3" />
                            <Button Content="Remove" Command="{Binding RemoveOverlayCommand}" Margin="6,0,0,0" Padding="10,3" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Overlays}" SelectedItem="{Binding SelectedOverlay}"
                                 MinHeight="220" Margin="0,8,0,0" DisplayMemberPath="Name" />
                    </StackPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedOverlay}" Margin="8,0,0,0">
                            <TextBlock FontSize="15" FontWeight="Bold" Margin="0,0,0,8">
                                <Run Text="Settings for: " /><Run Text="{Binding Name, Mode=OneWay}" />
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Chat source:" Width="170" VerticalAlignment="Center" />
                                <ComboBox Width="160" SelectedItem="{Binding Mode}"
                                          ItemsSource="{x:Static vm:MainViewModel.AllChatModes}" />
                                <TextBlock Text="   All = merged from every platform below" FontSize="11" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <TextBlock Text="Twitch channel:" Width="170" VerticalAlignment="Center" />
                                <TextBox Width="200" Text="{Binding TwitchChannel}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Kick channel:" Width="170" VerticalAlignment="Center" />
                                <TextBox Width="200" Text="{Binding KickChannel}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Kick chatroom id (optional):" Width="170" VerticalAlignment="Center" />
                                <TextBox Width="200" Text="{Binding KickChatroomId}" />
                                <TextBlock Text="  used only if auto-resolve is blocked" FontSize="11" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="YouTube URL / @handle:" Width="170" VerticalAlignment="Center" />
                                <TextBox Width="200" Text="{Binding YouTubeUrl}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="TikTok @handle:" Width="170" VerticalAlignment="Center" />
                                <TextBox Width="200" Text="{Binding TikTokHandle}" />
                            </StackPanel>

                            <Separator Margin="0,12" />

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Background opacity:" Width="170" VerticalAlignment="Center" />
                                <Slider Width="220" Minimum="0" Maximum="1" Value="{Binding BackgroundOpacity}" />
                                <TextBlock Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Font size:" Width="170" VerticalAlignment="Center" />
                                <Slider Width="220" Minimum="9" Maximum="40" Value="{Binding FontSize}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                <TextBlock Text="{Binding FontSize}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Max messages:" Width="170" VerticalAlignment="Center" />
                                <Slider Width="220" Minimum="5" Maximum="100" Value="{Binding MaxMessages}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                <TextBlock Text="{Binding MaxMessages}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <Separator Margin="0,12" />

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <CheckBox IsChecked="{Binding Locked}" Content="Locked (click-through: mouse passes through to your game)" Margin="0,0,0,2" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <CheckBox IsChecked="{Binding IsVisible}" Content="Shown on screen" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <Button Content="Send test messages"
                                        Command="{Binding DataContext.TestOverlayMessagesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="10,3" />
                                <TextBlock Text="  injects fake chat lines into this overlay - no network needed" FontSize="11"
                                           Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Position/size: drag the overlay by its title bar while unlocked; resize from the edges. Ctrl+Alt+C locks/unlocks ALL overlays at once."
                                       FontSize="11" Foreground="#FF9AA0A8" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="Channel changes reconnect automatically. Fullscreen-exclusive games hide overlays - use borderless fullscreen in your game."
                                       FontSize="11" Foreground="#FF9AA0A8" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Commands">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TwitchAccountText, Mode=OneWay}"
                                   Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                        <TextBlock Text="!commands handled by the toolkit" FontSize="15" FontWeight="Bold" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Add command" Command="{Binding AddCommandCommand}" Padding="10,3" />
                        <Button Content="Remove" Command="{Binding RemoveCommandCommand}" Margin="6,0,0,0" Padding="10,3" />
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                            <DataGridTextColumn Header="Command (without !)" Binding="{Binding Name}" Width="160" />
                            <DataGridTextColumn Header="Chat reply" Binding="{Binding Response}" Width="*" />
                            <DataGridTextColumn Header="OBS scene (optional)" Binding="{Binding Scene}" Width="180" />
                            <DataGridTextColumn Header="Cooldown s" Binding="{Binding CooldownSeconds}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock Text="{Binding CommandActivityText, Mode=OneWay}" FontSize="11" Foreground="#FF8FD694"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="#FF9AA0A8" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Anyone in your chat types !name - the toolkit replies (Twitch only for now; Kick/YouTube stay read-only until their OAuth work) and switches OBS to the named scene if you set one. Commands run with a per-command cooldown. Moderation: right-click a chat line in an unlocked overlay for timeout / ban / delete (needs the Twitch login from the Chat Overlays tab and mod rights on that channel); Kick and YouTube moderation waits for their own logins." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Server Config">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Export server bundle..." Command="{Binding ExportServerCommand}" Padding="10,3" />
                            <TextBlock Text="nginx.conf the toolkit generates from your destinations (lives on your VPS):"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                        </DockPanel>
                        <CheckBox Content="Show keys in preview (leave OFF while streaming)" IsChecked="{Binding ShowSecretsInPreview}" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBox Grid.Row="1" Text="{Binding NginxPreview, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12" Background="#FF1B1E24" Foreground="#FFD8DEE9"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="PreviewBox_TextChanged" />
                </Grid>
            </TabItem>

            <TabItem Header="Deploy">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF23272E" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FF5A4A22" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServerConfigOutdatedText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ServerConfigOutdatedText}" TextWrapping="Wrap"
                                           Foreground="#FFFFF0C0" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="One-click deploy - no terminal needed" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Server host (IP):" Width="180" VerticalAlignment="Center" />
                                <local:SecretBox Width="220" SecretText="{Binding Config.ServerHost}" VerticalAlignment="Center" />
                                <TextBlock Text="   SSH user (usually root):" Margin="16,0,0,0" VerticalAlignment="Center" />
                                <TextBox Width="140" Text="{Binding Config.SshUser}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <CheckBox Content="Use SSH key file instead of password" IsChecked="{Binding Config.SshUseKey}" VerticalAlignment="Center" />
                                <TextBlock Text="  SSH password:" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding Config.SshUseKey, Converter={StaticResource InvBoolToVis}}" />
                                <local:SecretBox Width="220" SecretText="{Binding SshPassword}" VerticalAlignment="Center"
                                                 Visibility="{Binding Config.SshUseKey, Converter={StaticResource InvBoolToVis}}" />
                                <TextBlock Text="  Key file path:" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding Config.SshUseKey, Converter={StaticResource BoolToVis}}" />
                                <TextBox Width="300" Text="{Binding Config.SshKeyPath}" VerticalAlignment="Center"
                                         Visibility="{Binding Config.SshUseKey, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <TextBlock Text="Remote folder:" Width="180" VerticalAlignment="Center" />
                                <TextBox Width="220" Text="{Binding Config.RemotePath}" VerticalAlignment="Center" />
                                <TextBlock Text="  first time? rent a VPS + install Docker once (server/VPS-SETUP.md steps 1-2), then this tab does the rest"
                                           FontSize="11" Margin="12,0,0,0" Foreground="#FF9AA0A8" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding RelayStatusText, Mode=OneWay}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="#FF8FD694" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test connection" Command="{Binding TestConnectionCommand}" Padding="10,3" />
                            <Button Content="Deploy to server" Command="{Binding DeployCommand}" Margin="6,0,0,0" Padding="10,3" />
                            <Button Content="Refresh status" Command="{Binding RefreshStatusCommand}" Margin="6,0,0,0" Padding="10,3" />
                            <CheckBox Content="auto (10s)" IsChecked="{Binding AutoStatus}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding IsRunning, StringFormat=busy: {0}}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="#FF9AA0A8" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBox Grid.Row="2" Text="{Binding DeployLog, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12" Background="#FF1B1E24" Foreground="#FFD8DEE9"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextChanged="PreviewBox_TextChanged" />
                </Grid>
            </TabItem>

            <TabItem Header="Help">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="What this does, in one paragraph" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Your home internet only has to send ONE stream. It goes to a cheap cloud server you rent (a 'VPS'). That server runs nginx + ffmpeg: it forwards a straight copy of your stream to every landscape destination, and builds portrait 1080x1920 versions (center-crop or blurred bars) for phone-first platforms like TikTok and YouTube Shorts. Your platform stream keys live on the server, not in OBS - change platforms without touching OBS." />

                        <TextBlock Text="Quick start" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="1) Fill in your destination ingest URLs and stream keys (copied from each platform's dashboard).&#x0a;2) Click 'Export server bundle...' - get a folder.&#x0a;3) Follow SETUP.md inside that folder to rent a VPS and start the relay (about 10 minutes, no experience needed).&#x0a;4) In OBS: Settings -> Stream -> Custom, server rtmp://YOUR.SERVER.IP/live, key = your stream name.&#x0a;5) Go live everywhere at once. Watch the toolkit's overlay tab for chat." />

                        <TextBlock Text="Output Studio" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="The Output Studio tab is a visual editor for everything the server sends out. Each enabled destination is a card in the pipeline: drag cards (or use the arrows) to set the order the server starts outputs in, click one to tune encoding (encoder preset, fps override, audio bitrate, keyframes, extra ffmpeg args, per-destination delay). Destinations can switch to a Custom layer layout: cut any rectangles out of your input (camera, game, anything) and move/resize them freely, overlay transparent PNGs, mark blur areas or spots where the background shows through, and set an image or animated GIF background - layers stack bottom to top and everything drag-positions in the preview. Preview sources: Mirror captures your OBS window locally for instant feedback; Server output (~2 fps) pulls the true rendered output back from the relay over SSH (snapshots are always written by ffmpeg-routed outputs - redeploy once so the server has them). The box at the bottom shows the exact lines the destination adds to nginx.conf (keys hidden until you tick 'show keys')." />

                        <TextBlock Text="Chat overlays" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Overlays are transparent windows that float over your game. Unlock them (Ctrl+Alt+C) to drag and resize; lock them so clicks pass through to the game. Each overlay can merge every platform or show just one - add as many as you like. Twitch needs no login (anonymous read), Kick uses its public websocket, YouTube uses its public live-chat endpoint, and TikTok reads through an Euler Stream signed websocket (free API key - get one at eulerstream.com and paste it above)." />

                        <TextBlock Text="Keys &amp; privacy" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Stream keys and your server IP live in a separate keys file (secrets.json next to your config by default). It loads when the toolkit starts; 'Open...' points the toolkit at an existing file and 'Move to...' relocates it (USB stick, sync folder). Key and IP fields are masked with dots until you click into them, and the Server Config preview hides keys unless you tick 'Show keys in preview' - so nothing sensitive flashes on stream. The exported server bundle still needs real keys inside its nginx.conf (the relay can't connect without them), and that folder ships with a .gitignore so it can't be committed." />

                        <TextBlock Text="Costs" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="The only cost is the VPS: roughly 4-6 EUR/month for typical multi-streaming (Hetzner CX22 includes 20 TB of traffic; Oracle Cloud has a free tier big enough). The status bar at the bottom of the Relay tab estimates your server's traffic so you can stay inside the allowance." />

                        <TextBlock Text="Live lights &amp; what's next" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Each destination card shows two lights: the relay-side push light (is the server actually sending?) and the platform-side live light (does the platform show the stream?). Live checks poll the platforms every 30 seconds using each destination's Handle column, falling back to your 'My channels' entries - a green push light next to a dark live light means the server is sending but the platform is not showing it. The watchdog watches the same picture every 10 seconds: if the relay dies, your OBS feed drops mid-stream, an output's encoder dies or freezes, or a push starts failing, a red WATCHDOG banner appears with the reason from the relay log; frozen encoders are killed automatically so nginx respawns them, and a Restart relay button is right there. Go live from the Relay tab: Start stream verifies the relay, starts OBS when 'Control OBS' is on (enable the obs-websocket plugin in OBS: Tools -> WebSocket Server Settings, same password as here), and confirms your stream actually arrives; End stream does the reverse. Moderation and !commands are live: log in on the Chat Overlays tab, right-click a chat line in an unlocked overlay to timeout/ban/delete, and build commands on the Commands tab. Up next on the roadmap: alert overlays, title/category sync, and OBS scene auto-switching. See docs/ROADMAP.md." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
