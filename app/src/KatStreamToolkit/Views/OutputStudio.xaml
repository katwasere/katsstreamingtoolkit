<UserControl x:Class="KatStreamToolkit.Views.OutputStudio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KatStreamToolkit.ViewModels"
             xmlns:local="clr-namespace:KatStreamToolkit.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:NullToVisibilityConverter x:Key="NullToVis" />
        <local:NullToVisibilityConverter x:Key="NotNullToVis" Inverted="True" />
        <local:LightBrushConverter x:Key="LightBrush" />
        <local:EqualsToVisibilityConverter x:Key="WhenCustom" />
        <local:EqualsToVisibilityConverter x:Key="WhenNotCustom" Inverted="True" />
        <local:EqualsToVisibilityConverter x:Key="NotEqualsVis" Inverted="True" />

        <Style x:Key="CardListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF9AA0A8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- BasedOn the app's implicit Button style, otherwise buttons fall back to
             WPF's light default chrome and the glyphs vanish on dark rows. -->
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Row 0: pipeline flow ============ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <DockPanel Margin="0,2,0,8">
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Add destination"
                        Command="{Binding AddDestinationCommand}" Padding="10,3" />
                <TextBlock Text="Destination pipeline" FontSize="15" FontWeight="Bold" />
            </DockPanel>
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                       Text="Cards flow left to right. Drag a card onto another to reorder (or use the arrows) - the order here is the order the server starts each output in nginx.conf. Click a card to edit it below." />

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#FF2D5B8A" CornerRadius="6" Padding="14,10" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Foreground="White" FontWeight="SemiBold"><Run Text="OBS" /><LineBreak /><Run Text="(your PC)" FontSize="10" /></TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="  ──▶  " VerticalAlignment="Center" Foreground="#FF9AA0A8" />
                    <Border Background="#FF6E3A8C" CornerRadius="6" Padding="14,10" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Foreground="White" FontWeight="SemiBold"><Run Text="Relay server" /><LineBreak /><Run Text="nginx + ffmpeg" FontSize="10" /></TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="  ──▶  " VerticalAlignment="Center" Foreground="#FF9AA0A8" />

                    <ListBox x:Name="CardsList" ItemsSource="{Binding Destinations}"
                             SelectedItem="{Binding SelectedDestination}"
                             ItemContainerStyle="{StaticResource CardListBoxItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="CardsList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="CardsList_PreviewMouseMove"
                             DragOver="CardsList_DragOver"
                             Drop="CardsList_Drop">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="180" Margin="0,0,8,8" CornerRadius="6" Padding="10,8"
                                        Background="#FF1E4D2E" BorderBrush="#FF3C3C3C" BorderThickness="1"
                                        Cursor="Hand" ToolTip="Drag onto another card to reorder">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FF8FD694" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="#FFB9C2CC" FontSize="10">
                                            <Run Text="{Binding Platform, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding Orientation, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding VideoBitrateKbps, Mode=OneWay}" />
                                            <Run Text=" kbps" />
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding PushLight, Converter={StaticResource LightBrush}}" />
                                            <TextBlock Text="{Binding PushLightText, Mode=OneWay}" FontSize="10" Foreground="#FFDDE3EA" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource MiniButton}" Content="◀" ToolTip="Move earlier"
                                                    Command="{Binding DataContext.MoveDestinationLeftCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource MiniButton}" Content="▶" ToolTip="Move later"
                                                    Command="{Binding DataContext.MoveDestinationRightCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                       Text="No destinations yet? Add one here or on the Relay &amp; Routing tab - it appears as a card as soon as it exists." />
        </StackPanel>

        <!-- ============ Row 1: inspector + rendition preview ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <Grid>
                    <TextBlock Text="Select a destination card above to edit what the server sends out for it."
                               Visibility="{Binding SelectedDestination, Converter={StaticResource NullToVis}}"
                               Foreground="#FF9AA0A8" Margin="4,20,0,0" TextWrapping="Wrap" />

                    <StackPanel DataContext="{Binding SelectedDestination}"
                                Visibility="{Binding DataContext.SelectedDestination, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource NotNullToVis}}"
                                MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock FontSize="15" FontWeight="Bold" Margin="0,0,0,8">
                            <Run Text="Editing: " /><Run Text="{Binding Name, Mode=OneWay}" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <CheckBox IsChecked="{Binding Enabled}" Content="Enabled (the server only sends enabled destinations)" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                            <TextBlock Text="Name:" Width="170" VerticalAlignment="Center" />
                            <TextBox Width="220" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <TextBlock Text="Platform:" Width="170" VerticalAlignment="Center" />
                            <ComboBox Width="140" SelectedItem="{Binding Platform}"
                                      ItemsSource="{x:Static vm:MainViewModel.AllPlatforms}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <TextBlock Text="Orientation:" Width="170" VerticalAlignment="Center" />
                            <ComboBox Width="140" SelectedItem="{Binding Orientation}"
                                      ItemsSource="{x:Static vm:MainViewModel.AllOrientations}" />
                            <TextBlock Text="  landscape = straight copy, portrait = ffmpeg rebuild" FontSize="11"
                                       Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <TextBlock Text="Layout style:" Width="170" VerticalAlignment="Center" />
                            <ComboBox Width="150" SelectedItem="{Binding PortraitStyle}"
                                      ItemsSource="{x:Static vm:MainViewModel.AllPortraitStyles}" />
                            <TextBlock Text="  Custom = edit this feed with layers (see below)" FontSize="11"
                                       Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <Separator Margin="0,10" />

                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Ingest URL (from dashboard):" Width="170" VerticalAlignment="Center" />
                            <TextBox Width="300" Text="{Binding IngestUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Stream key:" Width="170" VerticalAlignment="Center" />
                            <local:SecretBox Width="220" SecretText="{Binding StreamKey}" />
                        </StackPanel>

                        <Separator Margin="0,10" />

                        <TextBlock Text="Encoding (portrait destinations; landscape is a untouched copy)" FontSize="13"
                                   FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Video bitrate (kbps):" Width="170" VerticalAlignment="Center" />
                            <TextBox Width="80" Text="{Binding VideoBitrateKbps}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Audio bitrate (kbps):" Width="170" VerticalAlignment="Center" />
                            <TextBox Width="80" Text="{Binding AudioBitrateKbps}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Keyframe interval (s):" Width="170" VerticalAlignment="Center" />
                            <TextBox Width="60" Text="{Binding KeyframeSeconds}" />
                            <TextBlock Text="  keep 2s for most platforms" FontSize="11" Foreground="#FF9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Encoder preset:" Width="170" VerticalAlignment="Center" />
                            <ComboBox Width="140" SelectedItem="{Binding EncoderPreset}"
                                      ItemsSource="{x:Static vm:MainViewModel.AllEncoderPresets}" />
                            <TextBlock Text="  slower = better quality per kbps, more server CPU" FontSize="11"
                                       Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="FPS override:" Width="170" VerticalAlignment="Center" />
                            <TextBox Width="60" Text="{Binding FpsOverride}" />
                            <TextBlock Text="  0 = same fps as OBS sends" FontSize="11" Foreground="#FF9AA0A8"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Delay (seconds):" Width="170" VerticalAlignment="Center" />
                            <TextBox Width="60" Text="{Binding DelaySeconds}" />
                            <TextBlock Text="  0 = off; holds the first frame N seconds (clip safety)" FontSize="11"
                                       Foreground="#FF9AA0A8" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Extra ffmpeg args:" Width="170" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Width="300" Text="{Binding ExtraArgs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="174,2,0,0"
                                   Text="Added just before the output URL, e.g. -tune zerolatency. Passed to ffmpeg as-is." />

                        <Separator Margin="0,10" />

                        <!-- Custom layout tools (portrait and landscape destinations) -->
                        <StackPanel>
                            <TextBlock Text="Custom layout" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                                       Text="Cut sections out of your input and move them around, overlay transparent PNGs, mark blurred areas or spots where the background shows through - then drag everything into place in the preview on the right. Works for portrait and landscape destinations." />
                            <Button Content="Switch to Custom layout" Click="SwitchToCustom_Click" Padding="8,2" HorizontalAlignment="Left"
                                    Visibility="{Binding PortraitStyle, Converter={StaticResource WhenNotCustom}, ConverterParameter=Custom}" />

                            <StackPanel x:Name="LegacyCustomTools" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                    <TextBlock Text="Crop width:" Width="170" VerticalAlignment="Center" />
                                    <Slider Width="220" Minimum="0.02" Maximum="0.6" Value="{Binding CropW}"
                                            IsSnapToTickEnabled="True" TickFrequency="0.01" />
                                    <TextBlock Text="{Binding CropW, StringFormat={}{0:P0}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                    <TextBlock Text="Your stream size:" Width="170" VerticalAlignment="Center" />
                                    <Slider Width="220" Minimum="0.05" Maximum="1" Value="{Binding FgScale}"
                                            IsSnapToTickEnabled="True" TickFrequency="0.05" />
                                    <TextBlock Text="{Binding FgScale, StringFormat={}{0:P0}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="LayerEditorPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4"
                                           Text="Layers stack bottom to top - first in the list is furthest back. Drag pieces in the result preview to move them; select one to fine-tune it here." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="+ Source cut" Click="AddSourceLayer_Click" Padding="8,2" />
                                    <Button Content="+ Image overlay" Click="AddImageLayer_Click" Padding="8,2" Margin="6,0,0,0" />
                                    <Button Content="+ Blur area" Click="AddBlurLayer_Click" Padding="8,2" Margin="6,0,0,0" />
                                    <Button Content="+ Show background" Click="AddRevealLayer_Click" Padding="8,2" Margin="6,0,0,0" />
                                </StackPanel>
                                <ListBox x:Name="LayersList" MinHeight="52" MaxHeight="130" Margin="0,6,0,0"
                                         Background="#FF1B1E24" BorderBrush="#FF3C3C3C"
                                         SelectionChanged="LayersList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <Button Content="▲" Click="LayerForward_Click" ToolTip="Bring forward" Style="{StaticResource MiniButton}" />
                                                    <Button Content="▼" Click="LayerBackward_Click" ToolTip="Send backward" Style="{StaticResource MiniButton}" Margin="0,0,0,0" />
                                                    <Button Content="✕" Click="LayerDelete_Click" ToolTip="Delete layer" Style="{StaticResource MiniButton}" Margin="0,0,4,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#FFE6E8EB" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel x:Name="LayerPropsPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="LayerPropsTitle" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Position X / Y:" Width="140" VerticalAlignment="Center" />
                                        <Slider x:Name="LayerXSlider" Width="140" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="LayerSlider_ValueChanged" />
                                        <Slider x:Name="LayerYSlider" Width="140" Margin="8,0,0,0" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="LayerSlider_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                        <TextBlock Text="Size W / H:" Width="140" VerticalAlignment="Center" />
                                        <Slider x:Name="LayerWSlider" Width="140" Minimum="0.01" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="LayerSlider_ValueChanged" />
                                        <Slider x:Name="LayerHSlider" Width="140" Margin="8,0,0,0" Minimum="0.01" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="LayerSlider_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel x:Name="LayerSrcPanel" Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,2"
                                                   Text="Source area - which part of your input this cut takes. Drag on 'Your output' (right) with this layer selected, or use the sliders." />
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Source X / Y:" Width="140" VerticalAlignment="Center" />
                                            <Slider x:Name="SrcXSlider" Width="140" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="LayerSlider_ValueChanged" />
                                            <Slider x:Name="SrcYSlider" Width="140" Margin="8,0,0,0" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="LayerSlider_ValueChanged" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                            <TextBlock Text="Source W / H:" Width="140" VerticalAlignment="Center" />
                                            <Slider x:Name="SrcWSlider" Width="140" Minimum="0.01" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="LayerSlider_ValueChanged" />
                                            <Slider x:Name="SrcHSlider" Width="140" Margin="8,0,0,0" Minimum="0.01" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="LayerSlider_ValueChanged" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="LayerImagePanel" Visibility="Collapsed" Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Load PNG overlay..." Click="LayerImage_Click" Padding="8,2" />
                                            <Button Content="Clear" Click="LayerImageClear_Click" Padding="8,2" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBox x:Name="LayerImagePathBox" Width="300" Margin="0,6,0,0" IsReadOnly="True" FontSize="11" />
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                                   Text="PNG with transparency recommended - it is stretched to this layer's size and shipped with the server bundle." />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding PortraitStyle, Converter={StaticResource WhenCustom}, ConverterParameter=Custom}" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Background image:" Width="170" VerticalAlignment="Top" Margin="0,4,0,0" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Load background..." Click="LoadBackground_Click" Padding="8,2" />
                                            <Button Content="Use blurred stream" Click="ClearBackground_Click" Padding="8,2" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBox Width="300" Margin="0,6,0,0" IsReadOnly="True" FontSize="11"
                                                 Text="{Binding CustomBackgroundPath, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                                   Text="Sits behind every layer. PNG for stills, GIF for an animated background; stretched to 1080x1920 and shipped with the server bundle." />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,10" />
                        <Button Content="Remove this destination" Command="{Binding DataContext.RemoveDestinationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="10,3" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Rendition preview -->
            <Border Grid.Column="1" Background="#FF23272E" CornerRadius="8" Padding="12" Width="430"
                    VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="What viewers see" FontSize="14" FontWeight="Bold" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,8"
                               Text="Rendered with the exact crop math the server uses, live while you edit." />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Preview source:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="PreviewSourceCombo" Width="200" SelectionChanged="PreviewSource_SelectionChanged"
                                  ToolTip="Mirror plays your local composition instantly; Server shows the true relay output at ~2 fps">
                            <ComboBoxItem Content="Mirror (auto, live)" IsSelected="True" />
                            <ComboBoxItem Content="Server output (~2 fps)" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8" x:Name="MirrorHint"
                               Text="Mirror auto-plays while you edit: it captures your OBS window when it can find one, otherwise your whole screen, at ~10 fps. The relay never streams video back continuously - the Server option below pulls tiny 2 fps snapshots over SSH instead." />

                    <TextBlock x:Name="LandscapeNote" TextWrapping="Wrap" Foreground="#FFB9C2CC" Margin="0,4"
                               Text="Landscape destinations push an untouched copy of your OBS output unless you switch them to the Custom layout below - then you can cut, move and overlay just like portrait, at your upstream resolution." />

                    <!-- Portrait: source + crop marks, then the cropped result -->
                    <StackPanel x:Name="CropSection">
                        <TextBlock x:Name="CropDragHint" Style="{StaticResource HintText}" Margin="0,0,0,4" Visibility="Collapsed"
                                   Text="Drag the green box over your output to set the crop." />
                        <TextBlock Text="Your output + kept crop (green)" Style="{StaticResource HintText}" Margin="0,0,0,4" />
                        <Grid x:Name="SourceBox" Width="380" Height="200" HorizontalAlignment="Left" Background="Transparent"
                              MouseLeftButtonDown="SourceCrop_MouseDown" MouseMove="SourceCrop_MouseMove" MouseLeftButtonUp="SourceCrop_MouseUp">
                            <local:FramePreview x:Name="srcFrame" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <local:CropOverlay x:Name="srcOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel x:Name="CropResultGroup">
                            <TextBlock Text="What portrait viewers get (1080x1920)" Style="{StaticResource HintText}" Margin="0,8,0,4" />
                            <Border BorderBrush="#FF3C3C3C" BorderThickness="1" HorizontalAlignment="Left">
                                <Canvas x:Name="resCanvas" Width="158" Height="280" ClipToBounds="True">
                                    <local:FramePreview x:Name="resFrame" />
                                </Canvas>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Portrait blurred-bars result -->
                    <StackPanel x:Name="BlurSection">
                        <TextBlock Text="What portrait viewers get (1080x1920)" Style="{StaticResource HintText}" Margin="0,0,0,4" />
                        <Border BorderBrush="#FF3C3C3C" BorderThickness="1" HorizontalAlignment="Left">
                            <Grid Width="158" Height="280" ClipToBounds="True">
                                <Canvas x:Name="blurCanvas" ClipToBounds="True">
                                    <local:FramePreview x:Name="blurBg" />
                                </Canvas>
                                <Border Background="#59000000" />
                                <local:FramePreview x:Name="blurFg" Width="158" Height="280" Stretch="Uniform" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Portrait custom layout result -->
                    <StackPanel x:Name="CustomSection">
                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4"
                                   Text="Result 1080x1920 - drag your stream to move it." />
                        <Border BorderBrush="#FF3C3C3C" BorderThickness="1" HorizontalAlignment="Left">
                            <Grid x:Name="CustomResultBox" Width="158" Height="280" ClipToBounds="True" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="CustomResult_MouseDown" MouseMove="CustomResult_MouseMove" MouseLeftButtonUp="CustomResult_MouseUp">
                                <Canvas x:Name="customBgCanvas" ClipToBounds="True">
                                    <local:FramePreview x:Name="customBgBlur" />
                                    <local:FramePreview x:Name="customBgImg" Stretch="Fill" />
                                </Canvas>
                                <Border x:Name="customBgShade" Background="#59000000" />
                                <Canvas x:Name="layerHost" ClipToBounds="True" />
                                <Canvas x:Name="customFgCanvas" ClipToBounds="True">
                                    <local:FramePreview x:Name="customFg" />
                                </Canvas>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- True server output (SSH snapshot, ~2 fps) -->
                    <StackPanel x:Name="ServerSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4"
                                   Text="True output from the relay (~2 fps snapshots over SSH). This is exactly what is about to be pushed to the platform." />
                        <Border BorderBrush="#FF3C3C3C" BorderThickness="1" HorizontalAlignment="Left">
                            <Grid x:Name="ServerPreviewBox" Width="158" Height="280" Background="#FF101216">
                                <Image x:Name="ServerPreviewImage" Stretch="Uniform" />
                                <TextBlock x:Name="ServerWaitingText" Text="waiting for frames..."
                                           Foreground="#FF9AA0A8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="8" FontSize="11" />
                            </Grid>
                        </Border>
                        <Button Content="Show test card on all outputs (nothing is pushed to platforms)"
                                Click="TestCardServer_Click" Margin="0,8,0,0" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                   Text="Snapshots are always written by ffmpeg-routed outputs (portrait layouts, and landscape Custom): a tiny JPEG at ~2 fps. No frames while you are offline is normal - nginx only starts the encoders while a stream is being published. Use the button above to preview at any time." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Row 2: generated output ============ -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <DockPanel Margin="0,0,0,4">
                <CheckBox DockPanel.Dock="Right" Content="Show keys in preview (leave OFF while streaming)"
                          IsChecked="{Binding ShowSecretsInPreview}" VerticalAlignment="Center" />
                <TextBlock Text="Server output - the exact lines this destination adds to nginx.conf:"
                           FontWeight="SemiBold" />
            </DockPanel>
            <TextBox Text="{Binding SelectedCommandPreview, Mode=OneWay}" IsReadOnly="True" MinHeight="90" MaxHeight="160"
                     FontFamily="Consolas" FontSize="12" Background="#FF1B1E24" Foreground="#FFD8DEE9"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextChanged="PreviewBox_TextChanged" />
        </StackPanel>
    </Grid>
</UserControl>
