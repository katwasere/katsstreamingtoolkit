<Window x:Class="KatStreamToolkit.Views.PollOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poll widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        Foreground="#FFEEEEEE"
        ResizeMode="NoResize"
        SizeToContent="Height">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" CornerRadius="6" BorderThickness="1" BorderBrush="#33FFFFFF"
            Background="#E0111418" Padding="12,8"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <StackPanel x:Name="PollPanel">
            <DockPanel LastChildFill="True" Margin="0,0,0,2">
                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeLeft, Mode=OneWay}"
                           FontSize="11" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Kind, Mode=OneWay}" FontSize="11" FontWeight="Bold"
                           Foreground="#FF9146FF" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,5">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count, Mode=OneWay}"
                                           FontSize="11" Foreground="#FF9AA0A8" VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Title, Mode=OneWay}" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFEEEEEE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Leader, Mode=OneWay}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF9146FF" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock FontFamily="Consolas" Text="{Binding Bar, Mode=OneWay}"
                                       Foreground="#FF9146FF" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Total, Mode=OneWay}" FontSize="10" Foreground="#88FFFFFF"
                       Margin="0,2,0,0" />
        </StackPanel>
    </Border>
</Window>
