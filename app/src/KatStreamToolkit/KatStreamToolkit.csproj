<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KatStreamToolkit</RootNamespace>
    <AssemblyName>KatStreamToolkit</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.2.0</Version>
    <Product>KAT's Streaming Toolkit</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <!-- UseWindowsForms is enabled only for screen-capture GDI types; keep its
       namespaces out of scope so WPF types stay unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
